# Copy to .env.local (never commit real values).
# Without the two public Supabase values the site runs as a demo in the browser.

# Public: safe in the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY: lets administrators create logins (src/app/api/admin/people).
# Set it in Vercel's environment settings. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: where "Request a School Demo" emails go.
NEXT_PUBLIC_DEMO_REQUEST_EMAIL=
